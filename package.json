{
  "name": "@memotux/vue-plot",
  "version": "0.4.2",
  "keywords": [
    "chart",
    "d3",
    "data",
    "graphic",
    "plot",
    "ui",
    "vue"
  ],
  "homepage": "https://github.com/memotux/vue-plot",
  "author": {
    "name": "Romeo Mendez Fuentes",
    "email": "romeo@mendezfuentes.net",
    "url": "https://romeo.mendezfuentes.net"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/memotux/vue-plot.git"
  },
  "files": [
    "*.d.ts",
    "dist"
  ],
  "type": "module",
  "main": "./dist/vue-plot.js",
  "module": "./dist/vue-plot.js",
  "types": "./dist/src/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/vue-plot.js",
      "require": "./dist/vue-plot.umd.cjs"
    },
    "./components": {
      "types": "./dist/src/components/index.d.ts"
    },
    "./types": {
      "types": "./dist/src/types/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vitest dev",
    "build": "vite build",
    "test": "vitest",
    "release": "pnpm run build && changelogen --release && pnpm publish && git push --follow-tags",
    "logen": "changelogen --release",
    "nuxt": "pnpm --filter @memotux/nuxt-vue-plot"
  },
  "devDependencies": {
    "@observablehq/plot": "^0.6.17",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "changelogen": "catalog:",
    "happy-dom": "^20.11.2",
    "typescript": "catalog:",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.1",
    "vitest": "catalog:",
    "vue": "^3.5.41",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@observablehq/plot": "^0.6.17",
    "vue": "^3.5.0"
  },
  "packageManager": "pnpm@11.22.0"
}
