    },
    {
      "generator": "ico",
      "name": "favicon.ico",
      "folder": "public",
      "tag": "<link rel=\"icon\" type=\"image/ico\" href=\"{name}\">"
    },
    {
      "generator": "png",
      "name": "apple-icon-{size}x{size}.png",
      "folder": "public/icons",
      "background": true,
      "sizes": [120, 152, 167, 180]
    },
    {
      "generator": "svg",
      "name": "safari-pinned-tab.svg",
      "folder": "public/icons"
    },
    {
      "generator": "png",
      "name": "ms-icon-{size}x{size}.png",
      "folder": "public/icons",
      "sizes": [144]
    },
    {
      "generator": "png",
      "name": "icon-{size}x{size}.png",
      "folder": "public/icons",
      "sizes": [128, 192, 256, 384, 512]
    }
  ]
}
