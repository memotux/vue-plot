{
  "params": {
    "icon": "../../logos/logo.png",
    "quality": "10",
    "themeColor": "c4b28a",
    "pngColor": "c4b28a",
    "padding": [0, 0],
    "include": ["pwa"]
  },
  "assets": [
    {
      "generator": "png",
      "name": "favicon-{size}x{size}.png",
